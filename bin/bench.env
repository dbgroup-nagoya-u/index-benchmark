# Run benchmark over the following parameters
THREAD_CANDIDATES="1"
IMPL_CANDIDATES="b-tree"

# Repeat benchmark for the following number of times
BENCH_REPEAT_COUNT="5"

# Abort benchmark after the following duration
BENCH_TIME_OUT=3600

# Additional parameters for "run_over_params.sh"
INDEX_SIZE_CANDIDATES="100000000"
DURATION=10
READ_OP="read"
WRITE_OP="update_relevant"
WRITE_RATIO_CANDIDATES="0.0 0.05 0.5"
SKEW_CANDIDATES=$(seq 0.0 1.0 2.0)
SCAN_SIZE_CANDIDATES="1"
